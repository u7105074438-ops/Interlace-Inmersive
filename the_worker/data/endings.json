    "silk": "AXIS_SILK",
    "sweat": "AXIS_SWEAT",
    "ruin": "AXIS_RUIN"
  },
  "hybrid_rule": {
    "_nota": "Híbrido = ningún eje supera max_axis_share de la suma de los cuatro ejes (RUINA excluida). Con suma 0 no es híbrido y se aplica dominant_tie_break.",
