  "routine_templates": {
    "_nota": [
      "Tabla §24.5 como datos. segments: bloques horarios; el personaje está en 'location' desde 'start' (+ retraso aleatorio 0..jitter_minutes) hasta el inicio del siguiente segmento.",
      "location: 'home_room' = sala de trabajo del personaje; 'absent' = fuera del edificio (en su vivienda); 'assigned_zone' = zona de limpieza; cualquier otro valor es un id de sala. 'via' = sala por la que pasa al llegar o salir (fichaje en torniquetes).",
      "events: actividades insertadas dentro de la franja: count [min,max] repeticiones o every_minutes (periódicas) dentro de start_window; duration_minutes [min,max]; location o location_choices {sala: peso}. Una ventana cuyo final es anterior a su inicio cruza la medianoche.",
      "'floor_meeting_room' = sala de reuniones de su planta si existe, si no su home_room. 'other_floor' = una sala de trabajo de otra planta de su departamento."
    ],
    "tier_1_2": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        {
          "start": "08:15",
          "jitter_minutes": 30,
          "location": "home_room",
          "via": "turnstiles",
          "activity": "work"
        },
        { "start": "13:00", "location": "cafeteria", "activity": "lunch" },
        { "start": "14:00", "location": "home_room", "activity": "work" },
        { "start": "18:00", "jitter_minutes": 30, "location": "absent", "via": "turnstiles" }
      ],
      "events": []
    },
    "tier_3": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        {
          "start": "08:30",
          "jitter_minutes": 30,
          "location": "home_room",
          "via": "turnstiles",
          "activity": "work"
        },
        { "start": "13:00", "location": "cafeteria", "activity": "lunch" },
        { "start": "14:00", "location": "home_room", "activity": "work" },
        { "start": "18:00", "jitter_minutes": 45, "location": "absent", "via": "turnstiles" }
      ],
      "events": [
        {
          "activity": "meeting",
          "location": "floor_meeting_room",
          "count": [1, 2],
          "duration_minutes": [30, 60],
          "start_window": ["09:00", "12:30"]
        },
        {
          "activity": "visit_other_floor",
          "location": "other_floor",
          "count": [1, 2],
          "duration_minutes": [15, 45],
          "start_window": ["14:00", "17:30"]
        }
      ]
    },
    "tier_4": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        {
          "start": "08:00",
          "jitter_minutes": 30,
          "location": "home_room",
          "via": "turnstiles",
          "activity": "work"
        },
        {
          "start": "13:00",
          "location_choices": { "cafeteria": 0.7, "exec_dining": 0.3 },
          "activity": "lunch"
        },
        { "start": "14:00", "location": "home_room", "activity": "work" },
        { "start": "18:30", "jitter_minutes": 30, "location": "absent", "via": "turnstiles" }
      ],
      "events": [
        {
          "activity": "patrol_zone",
          "location": "home_room",
          "every_minutes": 60,
          "duration_minutes": [10, 15],
          "start_window": ["09:00", "12:30"]
        },
        {
          "activity": "assign_tasks",
          "location": "home_room",
          "count": [1, 1],
          "duration_minutes": [15, 20],
          "start_window": ["09:00", "09:30"]
        },
        {
          "activity": "short_meeting",
          "location": "floor_meeting_room",
          "count": [1, 2],
          "duration_minutes": [15, 30],
          "start_window": ["14:00", "17:30"]
        },
        {
          "activity": "attendance_check",
          "location": "home_room",
          "count": [1, 2],
          "duration_minutes": [5, 10],
          "start_window": ["14:00", "18:00"]
        }
      ]
    },
    "tier_5_6": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        {
          "start": "08:30",
          "jitter_minutes": 60,
          "location": "home_room",
          "via": "turnstiles",
          "activity": "work"
        },
        { "start": "13:00", "location": "exec_dining", "activity": "lunch" },
        { "start": "14:00", "location": "home_room", "activity": "work" },
        { "start": "18:00", "jitter_minutes": 120, "location": "absent", "via": "turnstiles" }
      ],
      "events": [
        {
          "activity": "long_meeting",
          "location_choices": { "aurora_room": 0.25, "meeting_12a": 0.3, "meeting_12b": 0.3, "video_conference": 0.15 },
          "count": [1, 1],
          "duration_minutes": [120, 210],
          "start_window": ["14:00", "15:00"],
          "leaves_office_empty": true
        }
      ]
    },
    "tier_7_8": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        {
          "start": "07:30",
          "jitter_minutes": 180,
          "location": "home_room",
          "via": "turnstiles",
          "activity": "work"
        },
        { "start": "13:00", "location": "exec_dining", "activity": "lunch" },
        { "start": "14:00", "location": "home_room", "activity": "work" },
        { "start": "17:00", "jitter_minutes": 240, "location": "absent", "via": "turnstiles" }
      ],
      "events": [
        {
          "activity": "agenda",
          "location_choices": { "boardroom": 0.25, "press_room": 0.2, "investor_lounge": 0.3, "ceo_boardroom": 0.25 },
          "count": [2, 4],
          "duration_minutes": [30, 90],
          "start_window": ["09:00", "17:30"]
        }
      ],
      "travel_day_probability": 0.1
    },
    "guard_day": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        { "start": "07:00", "location": "home_room", "via": "security_locker_room", "activity": "watch" },
        { "start": "13:00", "location": "security_locker_room", "activity": "relief" },
        { "start": "14:00", "location": "home_room", "activity": "watch" },
        { "start": "19:00", "location": "absent", "via": "security_locker_room" }
      ],
      "events": [
        {
          "activity": "round",
          "location": "assigned_round",
          "every_minutes": 90,
          "duration_minutes": [25, 35],
          "start_window": ["07:30", "18:30"]
        }
      ]
    },
    "guard_night": {
      "segments": [
        { "start": "00:00", "location": "home_room", "activity": "watch" },
        { "start": "07:00", "location": "absent", "via": "security_locker_room" },
        { "start": "19:00", "location": "home_room", "via": "security_locker_room", "activity": "watch" }
      ],
      "events": [
        {
          "activity": "round",
          "location": "assigned_round",
          "every_minutes": 90,
          "duration_minutes": [25, 35],
          "start_window": ["19:30", "07:00"]
        }
      ]
    },
    "cleaning": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        { "start": "17:00", "location": "cleaning_locker_room", "activity": "preparation" },
        { "start": "18:00", "location": "assigned_zone", "activity": "clean" },
        { "start": "22:00", "location": "absent", "via": "cleaning_locker_room" }
      ],
      "events": []
    },
    "exterior_local": {
      "segments": [
        { "start": "00:00", "location": "absent" },
        { "start": "08:00", "jitter_minutes": 60, "location": "home_room", "activity": "work" },
        { "start": "13:00", "location": "street", "activity": "lunch" },
        { "start": "14:00", "location": "home_room", "activity": "work" },
        { "start": "20:00", "jitter_minutes": 60, "location": "absent" }
      ],
      "events": []
    },
    "exterior_police": {
      "segments": [
        { "start": "00:00", "location": "home_room", "activity": "on_duty" }
      ],
      "events": [
        {
          "activity": "patrol",
          "location_choices": { "street": 0.6, "alleys": 0.2, "transport_stop": 0.2 },
          "every_minutes": 120,
          "duration_minutes": [20, 40],
          "start_window": ["00:00", "23:59"]
        }
      ]
    }
  },
